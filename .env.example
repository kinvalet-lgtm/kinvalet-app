# ── Database ─────────────────────────────────────────────────────────────────
# Supabase transaction-mode pooler URL (port 6543)
DATABASE_URL=postgresql+asyncpg://sandwich:[password]@[host]:6543/postgres
DATABASE_SYNC_URL=postgresql://sandwich:[password]@[host]:6543/postgres

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-256-bit-key

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Twilio / WhatsApp ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WEBHOOK_BASE_URL=https://your-api.railway.app

# ── LLM (via LiteLLM) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...  # optional fallback

# ── Google ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_MAPS_API_KEY=AIza...

# ── Microsoft ─────────────────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_CLIENT_SECRET=xxxx~xxxx

# ── Plaid ─────────────────────────────────────────────────────────────────────
PLAID_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
PLAID_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PLAID_ENV=sandbox

# ── LLM routing thresholds ────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.90
NOTIFICATION_DAILY_CEILING=12

# ── Secrets storage ───────────────────────────────────────────────────────────
# In production, use AWS Secrets Manager; in development, use env vars
SECRETS_BACKEND=env  # env | aws_secrets_manager
AWS_REGION=us-east-1
